{
  "manifest_version": 3,
  "name": "MIRROR",
  "version": "0.2.0",
  "description": "Check AI responses for implicit demographic assumptions. Reads a conversation only when you ask.",
  "minimum_chrome_version": "116",
  "permissions": ["sidePanel"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://claude.ai/*",
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ],
  "action": { "default_title": "Open MIRROR" },
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "ui/index.html" },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://claude.ai/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
